# =============================================================================
# EatoBiotics — Environment Variables
# Copy to `.env.local` for local dev. Set the same keys in Vercel for prod.
# =============================================================================

# --- Supabase (auth + database) ----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=                          # same as NEXT_PUBLIC_SUPABASE_URL; server fallback
SUPABASE_SERVICE_ROLE_KEY=             # server-only — never expose
SUPABASE_RECIPE_IMAGE_BUCKET=          # storage bucket for plate-builder images

# --- Stripe (one-time + subscriptions) ---------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                 # set after creating the webhook endpoint
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=    # client-side checkout

# Subscription price IDs (one per tier)
STRIPE_GROW_PRICE_ID=
STRIPE_RESTORE_PRICE_ID=
STRIPE_TRANSFORM_PRICE_ID=
STRIPE_MEMBER_PRICE_ID=

# Public mirrors used by the pricing client
NEXT_PUBLIC_STRIPE_GROW_PRICE_ID=
NEXT_PUBLIC_STRIPE_RESTORE_PRICE_ID=
NEXT_PUBLIC_STRIPE_TRANSFORM_PRICE_ID=
NEXT_PUBLIC_STRIPE_MEMBER_PRICE_ID=

# Promo coupon IDs (optional — auto-applied when set)
STRIPE_WIN_COUPON_ID=
STRIPE_LOW_SCORE_COUPON_ID=
STRIPE_SHARE_COUPON_ID=

# --- AI providers ------------------------------------------------------------
ANTHROPIC_API_KEY=                     # Claude — consult, reports, weekly check-ins

OPENAI_API_KEY=                        # plate-builder recipes + images
OPENAI_RECIPE_MODEL=                   # e.g. gpt-4o-mini (optional override)
OPENAI_IMAGE_MODEL=                    # e.g. gpt-image-1 (optional override)

# --- Voice (ElevenLabs) ------------------------------------------------------
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=       # eatobiotic voice agent

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=                            # e.g. "EatoBiotics <hello@eatobiotics.com>"
OWNER_EMAIL=                           # internal BCC / notifications

# --- Analytics & feature flags ----------------------------------------------
NEXT_PUBLIC_STATSIG_CLIENT_KEY=
STATSIG_SERVER_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Cron, admin, preview gate ----------------------------------------------
CRON_SECRET=                           # bearer token guarding /api/weekly-checkin etc.
ADMIN_PASSWORD=                        # /admin login
DEV_PASSWORD=                          # preview-site password (required in prod-preview)
EATOBIOTICS_PASSWORD_GATE=             # "on" to force preview gate on
EATOBIOTICS_PASSWORD_GATE_DISABLED=    # "true" to bypass gate entirely

# --- Misc --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=                  # e.g. https://eatobiotics.com — used in email links + redirects
FOUNDING_MEMBER_CUTOFF_DATE=           # ISO date — subscriptions before this = founding member
NEXT_PUBLIC_FOUNDING_MEMBER_CUTOFF_DATE= # public mirror for pricing badge
